{
  "name": "decentpilgrimages",
  "version": "1.0.0",
  "description": "A Decent example for how to go on pilgrimage. DeCently.",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "npm run test:contracts && npm run test:ui",
    "test:contracts": "hardhat test test/DecentPilgrimageBaseV1.js test/Verification.js test/DecentPilgrimageGateV2.js",
    "abi:export": "hardhat run scripts/export-abi.js",
    "deploy": "hardhat run scripts/deploy.js",
    "verify": "hardhat run scripts/verify.js",
    "test:ui": "node --test test/ui/*.test.mjs",
    "test:payroll": "node --test test/ui/payroll.test.mjs",
    "payroll:validate": "node payroll/scripts/validatePayrollQueue.js",
    "assistant": "node assistant/server.mjs",
    "serve": "node assistant/static-server.mjs",
    "test:browser": "node --test test/browser/*.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheJollyLaMa/DecentPilgrimages.git"
  },
  "author": "TheJollyLaMa",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/TheJollyLaMa/DecentPilgrimages/issues"
  },
  "homepage": "https://github.com/TheJollyLaMa/DecentPilgrimages#readme",
  "dependencies": {
    "ethers": "^6.13.5",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-verify": "^2.0.11",
    "@openzeppelin/contracts": "^5.3.0",
    "chai": "^4.5.0",
    "hardhat": "^2.26.3",
    "playwright": "1.64.1"
  }
}
